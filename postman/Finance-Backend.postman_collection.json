    {
      "name": "Auth Routes",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "if (res.success) {\r",
                  "  pm.environment.set(\"access_token\", res.data.tokens.accessToken);\r",
                  "  pm.environment.set(\"refresh_token\", res.data.tokens.refreshToken);\r",
                  "  pm.test(\"Status 201\", () => pm.response.to.have.status(201));\r",
                  "  pm.test(\"Has access token\", () => pm.expect(res.data.tokens.accessToken).to.exist);\r",
                  "  pm.test(\"No password in response\", () => pm.expect(res.data.user.password).to.not.exist);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Admin User\",\r\n  \"email\": \"admin@test.com\",\r\n  \"password\": \"Admin@1234\"\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "api/auth/register",
              "host": [
                "api"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
